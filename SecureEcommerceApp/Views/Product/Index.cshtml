@{
    ViewData["Title"] = "Products";
}

<div class="container mt-5">
    <h1 class="text-primary text-center">Our Products</h1>
    <p class="text-center">Welcome! Since you are logged in, you can view our exclusive inventory.</p>

    <div class="row mt-4">
        <div class="col-md-4">
            <div class="card p-3 shadow-sm">
                <h3>Laptop Pro</h3>
                <p>$999.00</p>
                <button class="btn btn-primary">Add to Cart</button>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-3 shadow-sm">
                <h3>Wireless Mouse</h3>
                <p>$49.00</p>
                <button class="btn btn-primary">Add to Cart</button>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card p-3 shadow-sm">
                <h3>Mechanical Keyboard</h3>
                <p>$120.00</p>
                <button class="btn btn-primary">Add to Cart</button>
            </div>
        </div>
    </div>
</div>